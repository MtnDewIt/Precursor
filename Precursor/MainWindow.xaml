<Window x:Class="Precursor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Converters="clr-namespace:Precursor.Converters"
        Title="Precursor" Height="600" Width="1200">

    <Window.Resources>
        <Converters:ErrorLevelConverter x:Key="ErrorLevelConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TODO: Implement! -->
        <TextBlock Grid.Column="0" Grid.Row="0" Text="Tag Definition Report" FontWeight="Bold" 
           Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="Cache Definition Report" FontWeight="Bold" 
           Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="2" Grid.Row="0" Text="Tag Resource Definition Report" FontWeight="Bold" 
           Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="3" Grid.Row="0" Text="Blam File Report" FontWeight="Bold" 
           Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="4" Grid.Row="0" Text="Bitmap Resource Report" FontWeight="Bold" 
           Background="LightGray" TextAlignment="Left" Padding="5"/>

        <TextBlock Grid.Column="0" Grid.Row="1" Text="Builds" FontWeight="Bold" 
                   Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="1" Grid.Row="1" Text="Files" FontWeight="Bold" 
                   Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="2" Grid.Row="1" Text="Tag Groups" FontWeight="Bold" 
                   Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="3" Grid.Row="1" Text="Tags" FontWeight="Bold" 
                   Background="LightGray" TextAlignment="Left" Padding="5"/>
        <TextBlock Grid.Column="4" Grid.Row="1" Text="Errors" FontWeight="Bold" 
                   Background="LightGray" TextAlignment="Left" Padding="5"/>

        <ListBox Grid.Column="0" Grid.Row="2" Name="BuildsList" 
                 SelectionChanged="BuildsList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="{Binding ErrorLevel, Converter={StaticResource ErrorLevelConverter}}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Build}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding BuildInfo}" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding ErrorInfo}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Grid.Column="1" Grid.Row="2" Name="FilesList" 
                 SelectionChanged="FilesList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="{Binding ErrorLevel, Converter={StaticResource ErrorLevelConverter}}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FileInfo}" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding ErrorInfo}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Grid.Column="2" Grid.Row="2" Name="GroupsList" 
                 SelectionChanged="GroupsList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="{Binding ErrorLevel, Converter={StaticResource ErrorLevelConverter}}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="{Binding GroupTag}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding GroupName}"/>
                            <TextBlock Text="{Binding GroupInfo}" FontSize="10" Foreground="Gray"/>
                            <TextBlock Text="{Binding ErrorInfo}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Grid.Column="3" Grid.Row="2" Name="TagsList" 
                 SelectionChanged="TagsList_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="{Binding ErrorLevel, Converter={StaticResource ErrorLevelConverter}}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <StackPanel>
                            <TextBlock Text="{Binding TagName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ErrorInfo}" FontSize="10" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox Grid.Column="4" Grid.Row="2" Name="ErrorsList">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="#ffe6e6"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="Red" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>